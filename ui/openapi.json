                "$ref": "#/components/schemas/ProcessCtx"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "add_columns"
        ],
        "title": "AlterRequest",
        "description": "Additive-only schema evolution: new columns are always optional, so existing writers\n(which omit them) and readers (which read null for old rows) keep working."
      },
      "AlterResult": {
        "properties": {
          "op_id": {

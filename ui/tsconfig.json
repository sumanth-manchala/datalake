{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "src/*": ["./src/*"], "openapi-gen/*": ["./openapi-gen/*"] },
    "types": ["vite/client", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src", "openapi-gen", "vite.config.ts"]
}
